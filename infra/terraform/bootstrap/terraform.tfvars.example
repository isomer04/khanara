# Copy to terraform.tfvars (gitignored) and fill in.
# The runbook creates the project with gcloud first, so only project_id is needed.
project_id = "khanara-prod-123456"
region     = "us-central1"

# Alternatively let Terraform create it:
# create_project  = true
# org_id          = "123456789012"         # gcloud organizations list
# billing_account = "012345-6789AB-CDEF01" # gcloud billing accounts list
