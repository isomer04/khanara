# Copy to terraform.tfvars (gitignored) and fill in. The DB password and JWT
# key are generated; only the third-party keys below are secret.
project_id            = "khanara-prod-123456"
billing_account       = "012345-6789AB-CDEF01"
cloudinary_cloud_name = "your-cloud-name"

# Ephemeral: sent straight to Secret Manager, never stored in Terraform state.
# After changing any of them, bump third_party_secrets_version so they're published.
third_party_secrets = {
  "cloudinary-api-key"    = ""
  "cloudinary-api-secret" = ""
  "stripe-secret-key"     = ""
  "stripe-webhook-secret" = "pending" # until the endpoint exists; then the whsec_... of `terraform output stripe_webhook_url`
}
# third_party_secrets_version = 2

# Records you already have at the registrar that must survive the move to
# Cloud DNS (check with: nslookup -type=TXT khanara.shop).
apex_txt_records = [
  "google-site-verification=REPLACE_WITH_EXISTING_VALUE",
]
# mx_records = ["1 smtp.google.com."]

# Turn on once `gcloud domains list-user-verified` shows the domain for the
# account running Terraform:
# enable_domain_mapping = true

# Optional overrides
# region               = "us-central1"
# domain               = "khanara.shop"
# github_repository    = "isomer04/khanara"
# daily_reset_hour_utc = 3
# monthly_budget_usd   = 25
# budget_currency_code = "USD" # must match the billing account currency
